{
    "name": "shopkit/themes",
    "description": "Official Shopkit themes and local theme development CLI",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-json": "*",
        "twbs/bootstrap": "~4.5.3.0",
        "twig/twig": "^3.28",
        "wikimedia/less.php": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Shopkit\\Themes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shopkit\\Themes\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/shopkit-themes"
    ],
    "archive": {
        "exclude": [
            "/.github",
            "/.phpunit.cache",
            "/composer.lock",
            "/phpunit.xml.dist",
            "/tests",
            "/vendor"
        ]
    },
    "scripts": {
        "test": "phpunit"
    }
}
